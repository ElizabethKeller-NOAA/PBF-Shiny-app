# We keep them as a list of strings for now
summarize(PBF_list = list(unique(PBF)), .groups = "drop")
# 2. Create the Flextable
ft <- flextable(final_table) %>%
# This part turns the list into bullets
compose(
j = "PBF_list",
value = as_paragraph(
as_chunk(unlist(PBF_list), props = fp_text(), formatter = function(x) paste0("• ", x, "\n"))
)
) %>%
# Formatting for Word
set_header_labels(Species_full = "Species", PBF_list = "PBF") %>%
autofit() %>%
width(j = 2, width = 4) # Adjust width so bullets look right
# 1. Process the dataframe
final_table <- PBFs %>%
filter(Species_full %in% selected_species) %>%
group_by(Species_full) %>%
# Create a single string with bullets and newlines
summarize(
PBF = paste0("\u2022 ", unique(PBF), collapse = "\n"),
.groups = "drop"
)
# 2. Create the Flextable
ft <- flextable(final_table) %>%
# This tells flextable to honor the \n as a line break
valign(j = "PBF", valign = "top") %>%
# Ensure the column is wide enough so bullets don't wrap strangely
width(j = "PBF", width = 4) %>%
set_header_labels(Species_full = "Species", PBF = "Primary Biological Features") %>%
theme_vanilla()
