library(dplyr)
library(flextable)
library(officer)
# 1. Keep PBFs as a list in your dataframe
final_table <- PBFs %>%
filter(Species_full %in% selected_species) %>%
group_by(Species_full) %>%
summarize(PBF_items = list(unique(PBF)), .groups = "drop")
# 2. Use compose with a loop to build the paragraph cell
ft <- flextable(final_table) %>%
compose(
j = "PBF_items",
value = as_paragraph(
# This 'map' function iterates through the list in each cell
# and turns each item into a real Word paragraph chunk
lapply(PBF_items, function(x) {
as_chunk(paste0(x, "\n"), props = fp_text())
})
)
) %>%
# Adding a 'hanging indent' makes it look like a real Word list
style(
j = "PBF_items",
pr_p = fp_par(padding.left = 15, text.indent = -15)
) %>%
set_header_labels(Species_full = "Species", PBF_items = "PBF") %>%
autofit()
# 1. Count actual NAs
sum(is.na(PBFs$PBF))
# 2. Count empty strings (often look empty but aren't NA)
sum(PBFs$PBF == "", na.rm = TRUE)
# 3. Find exactly which rows are causing issues
problem_rows <- PBFs %>%
filter(is.na(PBF) | PBF == "" | nchar(trimws(PBF)) == 0)
print(problem_rows)
