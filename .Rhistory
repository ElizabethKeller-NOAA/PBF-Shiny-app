library(officer)
# 1. (Keep your processing the same)
final_table <- PBFs %>%
filter(Species_full %in% selected_species) %>%
group_by(Species_full) %>%
summarize(PBF_list = list(unique(PBF)), .groups = "drop")
# 2. Create the Flextable
ft <- flextable(final_table) %>%
compose(
j = "PBF_list",
value = as_paragraph(
# We use list_sep = "" to prevent flextable from adding its own separators
# The lapply creates the chunks, and we wrap it in 'as_paragraph' logic
# that flextable can actually read.
lapply(PBF_list, function(x) {
# Create a chunk for every item in the species' list
# We add the bullet character here manually for the Word render
as_chunk(paste0("\u2022 ", x, "\n"))
})
)
) %>%
# Applying the hanging indent so long bullets wrap cleanly
padding(padding.top = 5, padding.bottom = 5, part = "all") %>%
style(
j = "PBF_list",
pr_p = fp_par(padding.left = 15, text.indent = -15)
) %>%
set_header_labels(Species_full = "Species", PBF_list = "PBF") %>%
autofit()
library(dplyr)
library(flextable)
library(officer)
# 1. First, collapse your data into a single string with newlines and bullets
# This avoids the "list-column" headache inside the table object.
final_table_formatted <- PBFs %>%
filter(Species_full %in% selected_species) %>%
group_by(Species_full) %>%
summarize(
PBF_text = paste0("\u2022 ", unique(PBF), collapse = "\n"),
.groups = "drop"
)
# 2. Create the Flextable using mk_par
ft <- flextable(final_table_formatted) %>%
# mk_par is often more stable than compose for simple text formatting
mk_par(
j = "PBF_text",
value = as_paragraph(as_chunk(PBF_text))
) %>%
# This setting is CRITICAL for Word to respect the \n as a line break
valign(j = "PBF_text", valign = "top") %>%
# Apply the hanging indent style for the "real bullet" look
style(
j = "PBF_text",
pr_p = fp_par(
padding.left = 15,
text.indent = -15,
line_spacing = 1.2
)
) %>%
set_header_labels(Species_full = "Species", PBF_text = "PBF") %>%
width(j = "PBF_text", width = 4) %>%
autofit()
ft
# 1. Process data (bullet character + newline)
final_table_formatted <- PBFs %>%
filter(Species_full %in% selected_species) %>%
group_by(Species_full) %>%
summarize(
PBF_text = paste0("\u2022 ", unique(PBF), collapse = "\n"),
.groups = "drop"
)
# 2. Create the Flextable
ft <- flextable(final_table_formatted) %>%
mk_par(
j = "PBF_text",
value = as_paragraph(as_chunk(PBF_text))
) %>%
# Fix for the hanging indent error:
style(
j = "PBF_text",
pr_p = fp_par(
padding.left = 20,  # Moves the whole block right
indent = -15,       # Pulls only the first line (the bullet) back left
line_spacing = 1.2
)
) %>%
set_header_labels(Species_full = "Species", PBF_text = "PBF") %>%
# Ensure the column is wide enough for the indent logic to work
width(j = "PBF_text", width = 4) %>%
valign(j = "PBF_text", valign = "top") %>%
theme_vanilla()
# 1. Prepare data with the bullet character
final_table_formatted <- PBFs %>%
filter(Species_full %in% selected_species) %>%
group_by(Species_full) %>%
summarize(
# \u2022 is the bullet, \t is a tab (Word recognizes this!)
PBF_text = paste0("\u2022\t", unique(PBF), collapse = "\n"),
.groups = "drop"
)
# 2. Create the Flextable
ft <- flextable(final_table_formatted) %>%
# Basic formatting
theme_booktabs() %>%
valign(j = "PBF_text", valign = "top") %>%
# Set the header names
set_header_labels(Species_full = "Species", PBF_text = "PBF") %>%
# Control the width so Word has room to wrap the text
width(j = "Species_full", width = 2) %>%
width(j = "PBF_text", width = 4.5) %>%
# Add simple padding to the cell for a clean look
padding(j = "PBF_text", padding.left = 10, part = "body")
# 3. View the table
ft
